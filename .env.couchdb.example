# Reference CouchDB server for the conformance tests in test/couchdb.
#
# Copy this file to .env.couchdb (gitignored) and fill in your own server, then
# run `make test-couchdb`. Without GOYDB_COUCHDB_URL the comparison against a
# real CouchDB is skipped and only goydb's own behaviour is asserted.
#
# GOYDB_COUCHDB_URL points at an *existing* database. The tests only create
# documents in it, using ids unique to each run, so a database-scoped member
# account is enough — no server admin and no database creation needed.
GOYDB_COUCHDB_URL=https://couchdb.example.org/goydb-test
GOYDB_COUCHDB_USER=goydb-test
GOYDB_COUCHDB_PASSWORD=
